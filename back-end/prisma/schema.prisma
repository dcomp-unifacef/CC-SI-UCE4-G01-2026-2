// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/*
 O nome de um model no Prisma:
 * deve iniciar com letra maiúscula
 * deve estar no singular
*/
model Paciente {
  id              Int      @id @default(autoincrement()) // Chave primária, autoincremental
  nome            String   // Nome completo do paciente
  cpf             String   @unique // CPF (somente números)
  data_nascimento DateTime @db.Date // Data de nascimento (obrigatória)
  logradouro      String?  // Rua/avenida do endereço
  numero          String?  // Número da casa
  complemento     String?  // Complemento do endereço (opcional)
  bairro          String?  // Bairro
  municipio       String?  // Município
  uf              String?  @db.Char(2) // UF
  telefone        String   // Telefone/celular
  email           String?  // E-mail (opcional)
  ativo           Boolean  @default(true) // Desativação lógica (US15)
  visitas         HistoricoVisita[] // Lista virtual: visitas do paciente (lado 1)
  consultas       Consulta[]
}

model Dentista {
  id    Int     @id @default(autoincrement())
  nome  String
  ativo Boolean @default(true)
  visitas HistoricoVisita[]
  consultas Consulta[]
}

model HistoricoVisita {
  id              Int      @id @default(autoincrement()) // Chave primária, autoincremental
  data_visita     DateTime @db.Date // Data em que o atendimento foi realizado
  procedimento    String   // Procedimento realizado
  observacoes     String?  // Observações clínicas (opcional)
  registro_antigo Boolean  @default(false)
  paciente_id     Int      // Chave estrangeira (obrigatória)
  paciente        Paciente @relation(fields: [paciente_id], references: [id], onDelete: Restrict)
  dentista_id     Int      // Dentista responsável pelo atendimento
  dentista        Dentista @relation(fields: [dentista_id], references: [id], onDelete: Restrict)
}

enum Perfil {
  SECRETARIA
  DENTISTA
  DONO
}

model Usuario {
  id                Int       @id @default(autoincrement())
  nome              String
  login             String    @unique
  senha_hash        String
  perfil            Perfil
  ativo             Boolean   @default(true)
  tentativas_falhas Int       @default(0)
  bloqueado_ate     DateTime? @db.Timestamptz(3)
  criado_em         DateTime  @default(now()) @db.Timestamptz(3)
  atualizado_em     DateTime  @updatedAt @db.Timestamptz(3)
  sessoes           Sessao[]
  configuracoes     Configuracao[]
  historicosConsulta HistoricoConsulta[]
}

model Configuracao {
  id                       Int      @id @default(1)
  sessao_inatividade_min   Int      @default(30)
  sessao_duracao_max_min   Int      @default(480)
  consulta_duracao_max_min Int      @default(240)
  atualizado_em            DateTime @updatedAt @db.Timestamptz(3)
  atualizado_por_id        Int?
  atualizado_por           Usuario? @relation(fields: [atualizado_por_id], references: [id], onDelete: Restrict)
}

model Sessao {
  id            Int       @id @default(autoincrement())
  token_hash    String    @unique
  usuario_id    Int
  usuario       Usuario   @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
  criada_em     DateTime  @default(now()) @db.Timestamptz(3)
  expira_em     DateTime  @db.Timestamptz(3)
  ultimo_uso_em DateTime  @default(now()) @db.Timestamptz(3)
  revogada_em   DateTime? @db.Timestamptz(3)

  @@index([usuario_id])
}

enum StatusConsulta {
  AGENDADA
  CONFIRMADA
  REALIZADA
  FALTOU
  CANCELADA
}

model Consulta {
  id            Int            @id @default(autoincrement())
  paciente_id   Int
  paciente      Paciente       @relation(fields: [paciente_id], references: [id], onDelete: Restrict)
  dentista_id   Int
  dentista      Dentista       @relation(fields: [dentista_id], references: [id], onDelete: Restrict)
  inicio_em     DateTime       @db.Timestamptz(3)
  duracao_min   Int
  fim_em        DateTime       @db.Timestamptz(3)
  status        StatusConsulta @default(AGENDADA)
  encaixe       Boolean        @default(false)
  criada_em     DateTime       @default(now()) @db.Timestamptz(3)
  atualizada_em DateTime       @updatedAt @db.Timestamptz(3)
  historico     HistoricoConsulta[]

  @@index([dentista_id, inicio_em])
  @@index([paciente_id])
}

enum TipoHistoricoConsulta {
  CRIACAO
  MUDANCA_DE_STATUS
  REAGENDAMENTO
}

model HistoricoConsulta {
  id                   Int                   @id @default(autoincrement())
  consulta_id          Int
  consulta             Consulta              @relation(fields: [consulta_id], references: [id], onDelete: Restrict)
  tipo                 TipoHistoricoConsulta
  status_anterior      StatusConsulta?
  status_novo          StatusConsulta
  inicio_anterior      DateTime?             @db.Timestamptz(3)
  inicio_novo          DateTime?             @db.Timestamptz(3)
  duracao_anterior_min Int?
  duracao_nova_min     Int?
  motivo               String?
  usuario_id           Int
  usuario              Usuario               @relation(fields: [usuario_id], references: [id], onDelete: Restrict)
  registrado_em        DateTime              @default(now()) @db.Timestamptz(3)

  @@index([consulta_id])
}
